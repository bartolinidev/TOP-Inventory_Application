<!DOCTYPE html>
<html lang="en">
  <%- include('partials/head') %>
  <body>
    <%- include('partials/header') %>
    <main>
      <div class="container">
        <h1><%= title %></h1>
        <section>
          <% roomStandards.forEach((s) => { %>
          <a href="/rooms/standard/<%= s.id %>" class="tile tile--groupedRooms">
            <span><b><%= s.name %></b> (<%= s.count %>)</span>
            <span class="tile__arrow" aria-hidden="true">&rarr;</span>
          </a>
          <% }) %>
        </section>
      </div>
    </main>
    <%- include('partials/footer') %>
  </body>
</html>
