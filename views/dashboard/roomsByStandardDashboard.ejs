<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head') %>
  <body>
    <%- include('../partials/header') %>
    <main>
      <div class="container">
        <h1><%= title %></h1>
        <a href="/rooms/create" class="add-btn"
          >Add room
          <span class="add-btn__plus" aria-hidden="true">&plus;</span></a
        >
        <section class="tiles-container">
          <% roomStandards.forEach((s) => { %>
          <a href="/rooms/standard/<%= s.id %>" class="tile tile--groupedRooms">
            <span><b><%= s.name %></b> (<%= s.count %>)</span>
            <span class="tile__arrow" aria-hidden="true">&rarr;</span>
          </a>
          <% }) %>
        </section>
      </div>
    </main>
    <%- include('../partials/footer') %>
  </body>
</html>
