<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head') %>
  <body>
    <%- include('../partials/header') %>
    <main>
      <div class="container">
        <h1>
          <%= title %>
        </h1>
        <section class="forms-container">
          <%- include('../partials/errors') %>
          <form action="/room-standards/create" method="post">
            <fieldset>
              <legend>Name</legend>
              <input
                type="text"
                id="name"
                name="name"
                minlength="1"
                maxlength="20"
                required
              />
            </fieldset>

            <fieldset>
              <legend>Amenities</legend>
              <div>
                <input
                  type="checkbox"
                  id="coffee_machine"
                  name="coffee_machine"
                  value="true"
                />
                <label for="coffee_machine"
                  ><%- include('../partials/icons/coffeeMachine') %></label
                >
              </div>
              <div>
                <input
                  type="checkbox"
                  id="bathtub"
                  name="bathtub"
                  value="true"
                />
                <label for="bathtub"
                  ><%- include('../partials/icons/bathtub') %></label
                >
              </div>
            </fieldset>

            <fieldset>
              <legend>Price</legend>
              <input
                type="number"
                id="price"
                name="price"
                min="0"
                step="0.01"
                required
              />
            </fieldset>

            <fieldset>
              <legend>Admin password</legend>
              <input
                type="password"
                id="admin_password"
                name="admin_password"
                required
              />
            </fieldset>

            <button type="submit" class="confirm-btn">
              Create standard
              <span class="delete-btn__check-icon" aria-hidden="true"
                >&check;</span
              >
            </button>
          </form>
        </section>
      </div>
    </main>
    <%- include('../partials/footer') %>
  </body>
</html>
